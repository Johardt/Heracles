    "either_task": {
      "type": "theseus:composite",
      "title": "Complete Either Task",
      "amount": 1,
      "tasks": {
        "dummy": {
          "type": "theseus:dummy",
          "title": "Use the Demo Command",
          "value": "reward_showcase"
        },
        "check": {
          "type": "theseus:check",
          "title": "Submit the Check"
        }
      }
    }
  },
  "rewards": {
    "announce": {
      "type": "theseus:command",
      "title": "Completion Message",
      "command": "tellraw @s {\"text\":\"Theseus reward types are working.\",\"color\":\"green\"}"
    },
    "loot": {
      "type": "theseus:loottable",
      "title": "Dungeon Loot",
      "loot_table": "minecraft:chests/simple_dungeon"
    },
    "choice": {
      "type": "theseus:selectable",
      "title": "Choose One",
      "amount": 1,
      "rewards": {
        "emeralds": {
          "type": "theseus:item",
          "title": "Three Emeralds",
          "item": { "id": "minecraft:emerald", "count": 3 }
        },
        "experience": {
          "type": "theseus:xp",
          "title": "Five Levels",
          "xptype": "level",
          "amount": 5
        }
      }
    }
