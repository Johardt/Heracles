{
  "display": {
    "icon": { "type": "theseus:item", "item": "minecraft:chest" },
    "icon_background": "theseus:textures/gui/quest_backgrounds/rounded_squares.png",
    "title": "Reward Showcase",
    "subtitle": "Composite tasks and remaining reward types",
    "description": [
      "Run /theseus dummy reward_showcase or submit the check task,",
      "then choose a reward and claim the quest."
